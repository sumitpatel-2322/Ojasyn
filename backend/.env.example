# Application runtime
APP_NAME=Ojasyn QMS API
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL connection (Psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://postgres:123456@localhost:5432/qms_db
DB_ECHO=false

# JWT / Security (MUST be >= 32 random chars; never use a hardcoded default)
JWT_SIGNING_KEY=sftumlifgtljkmoaxfvejkqsjksjvwhiacltimnja
JWT_ALGORITHM=HS256
JWT_ISSUER=ojasyn-api
JWT_AUDIENCE=ojasyn-clients
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS & Upload limits
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]
UPLOAD_MAX_BYTES=10485760

# External LLM Provider
GROQ_API_KEY=groq_api_key
LLM_MODEL_NAME=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=30.0

# Object Storage
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=vault_storage

# Optional Redis URL (leave unset for PostgreSQL-only outbox + LISTEN/NOTIFY)
REDIS_URL=
